# 当前环境-测试环境打包配置
VITE_ENV=test
# 资源路径修正（打包时使用 /AI-document 路径）
VITE_APP_PUBLIC_URL = '/AI-document/'
# api地址前缀
VITE_APP_API_BASE_URL= 'https://sppgpttest.gcycloud.cn'

# 讯飞网关ip端口
VITE_XF_GATEWAY_PATH = wss://sppgpttest.gcycloud.cn

# kkfileview只有测试环境有资源
VITE_APP_FILE_VIEW_URL = https://sppgpttest.gcycloud.cn/kkfile/onlinePreview

# 显示调试按钮（默认和Level12切换按钮）
VITE_APP_SHOW_DEBUG_BUTTONS = false

# 隐藏演示模式和文件夹选项（测试构建时隐藏）
VITE_APP_HIDE_DEMO_FEATURES = true
